{
  "name": "@smarter-poker/commander-shared",
  "version": "0.1.5",
  "description": "Shared code package for Smarter-Poker World Hub and Commander \u2014 UI components, hooks, engine utilities, lib helpers. Single source of truth eliminates copy-paste drift between repos.",
  "private": false,
  "main": "src/index.js",
  "type": "module",
  "files": [
    "src/"
  ],
  "exports": {
    ".": "./src/index.js",
    "./components/*": "./src/components/*",
    "./hooks/*": "./src/hooks/*",
    "./engine/*": "./src/engine/*",
    "./lib/*": "./src/lib/*"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepare": "git config core.hooksPath .husky 2>/dev/null || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Smarter-Poker/commander-shared.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "@supabase/supabase-js": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "next": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": false
    }
  }
}
